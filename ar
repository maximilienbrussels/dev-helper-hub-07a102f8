        "src/lib/faq-content.ts:245"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Business",
      "sources": [
        "src/lib/faq-content.ts:252"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Team building, seminars and private hire",
      "sources": [
        "src/lib/faq-content.ts:256"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "What does a team building cost?",
      "sources": [
        "src/lib/faq-content.ts:264"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "€50 per person for a half day (3h) and €80 per person for a full day (6h), one or two activities of your choice, drinks included.",
      "sources": [
        "src/lib/faq-content.ts:269"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "What is your capacity?",
      "sources": [
        "src/lib/faq-content.ts:277"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Up to 100 people at the farm (Brussels) and up to 200 people in the countryside (Sterrebeek).",
      "sources": [
        "src/lib/faq-content.ts:282"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Can I hire a room or privatise the farm?",
      "sources": [
        "src/lib/faq-content.ts:290"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Yes. Room hire starts at €150 per half day (up to ±150 people). Full private hire starts at €3,000 (up to 150 people), from 4 hours to several days.",
      "sources": [
        "src/lib/faq-content.ts:295"
      ],
      "germanPhrasePresent": true
    },
