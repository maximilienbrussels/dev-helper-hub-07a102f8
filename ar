      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Basket: keeps your order until you check out or empty it.",
      "sources": [
        "src/lib/cookie-statement.ts:129"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Security: a short technical key that protects our forms from abuse.",
      "sources": [
        "src/lib/cookie-statement.ts:130"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "This data stays inside your own browser and is never used to profile or follow you.",
      "sources": [
        "src/lib/cookie-statement.ts:133"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "3. What we do not do",
