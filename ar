      ],
      "germanPhrasePresent": true
    },
    {
      "text": "What you get",
      "sources": [
        "src/lib/volunteer-content.ts:132"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Apply",
      "sources": [
        "src/lib/volunteer-content.ts:133"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Mention this profile in your message so it reaches the right person straight away.",
      "sources": [
        "src/lib/volunteer-content.ts:134"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Project management & activities volunteer",
      "sources": [
        "src/lib/volunteer-content.ts:144"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "You support the team on projects, events and workshops for schools, families and the neighbourhood.",
      "sources": [
        "src/lib/volunteer-content.ts:149"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "At least one half-day a week, to be agreed. Often at weekends or during events.",
      "sources": [
        "src/lib/volunteer-content.ts:154"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Help prepare and co-run workshops (garden, compost, bees, animals).",
      "sources": [
        "src/lib/volunteer-content.ts:172"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Welcome groups and families on site.",
      "sources": [
        "src/lib/volunteer-content.ts:173"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Event logistics: set-up, stands, take-down.",
      "sources": [
        "src/lib/volunteer-content.ts:174"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Communication: photos, short texts, posters and social media content.",
      "sources": [
        "src/lib/volunteer-content.ts:175"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Administrative support for ongoing projects.",
      "sources": [
        "src/lib/volunteer-content.ts:176"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "You speak fluent French; Dutch or English is a plus.",
      "sources": [
        "src/lib/volunteer-content.ts:193"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "You enjoy working with children and groups.",
      "sources": [
        "src/lib/volunteer-content.ts:194"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "You are organised and keep calm on a busy day.",
      "sources": [
        "src/lib/volunteer-content.ts:195"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "You are available at weekends or during school holidays.",
      "sources": [
        "src/lib/volunteer-content.ts:196"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Training in urban-farming education.",
      "sources": [
        "src/lib/volunteer-content.ts:213"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "A place in a team that knows you by name within a week.",
      "sources": [
        "src/lib/volunteer-content.ts:214"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Volunteer insurance and travel reimbursement.",
      "sources": [
        "src/lib/volunteer-content.ts:215",
        "src/lib/volunteer-content.ts:296"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "A certificate for your CV or your studies.",
      "sources": [
        "src/lib/volunteer-content.ts:216",
        "src/lib/volunteer-content.ts:297"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Animal care volunteer",
      "sources": [
        "src/lib/volunteer-content.ts:225"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "You help care for the farm's sheep, goats, donkeys, chickens, rabbits and pigs.",
      "sources": [
        "src/lib/volunteer-content.ts:230"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "A fixed half-day shift each week, all year round — rain, frost included.",
      "sources": [
        "src/lib/volunteer-content.ts:235"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Feeding and watering, morning or evening.",
      "sources": [
        "src/lib/volunteer-content.ts:253"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Mucking out and bedding the stalls and pens.",
      "sources": [
        "src/lib/volunteer-content.ts:254"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Daily observation: behaviour, appetite, injuries — and reporting anything unusual.",
      "sources": [
        "src/lib/volunteer-content.ts:255"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Maintaining paddocks and paths, checking fences.",
      "sources": [
        "src/lib/volunteer-content.ts:256"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Explaining to visitors how to behave around the animals.",
      "sources": [
        "src/lib/volunteer-content.ts:257"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "You are physically fit: lifting, wheelbarrows, outdoor work.",
      "sources": [
        "src/lib/volunteer-content.ts:274"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "You are reliable — animals don't wait.",
      "sources": [
        "src/lib/volunteer-content.ts:275"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "You follow the keepers' instructions, including when an animal is ill.",
      "sources": [
        "src/lib/volunteer-content.ts:276"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "No experience required, but patience and consistency are.",
      "sources": [
        "src/lib/volunteer-content.ts:277"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Hands-on training in animal care on an urban farm.",
      "sources": [
        "src/lib/volunteer-content.ts:294"
      ],
      "germanPhrasePresent": true
    },
    {
      "text": "Work clothes and equipment provided on site.",
      "sources": [
