      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Bookings and orders: 7 years, as accounting law requires.",
      "sources": [
        "src/lib/legal-pages.ts:244"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Account and certificates: for as long as you keep your account; deleted within 30 days after closure.",
      "sources": [
        "src/lib/legal-pages.ts:245"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Server logs: 12 months maximum, for security and troubleshooting.",
      "sources": [
        "src/lib/legal-pages.ts:246"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "7. Who can see your data",
      "sources": [
        "src/lib/legal-pages.ts:250"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Only staff and volunteers handling your request, with role-based access rights. We never sell or rent your data.",
