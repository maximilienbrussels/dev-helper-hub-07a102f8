        "src/lib/maxim-instant.ts:94"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "You'll find us at Schipperijkaai/Quai du Batelage 2, 1000 Brussels — right by Maximilien Park, a short walk from Brussels-North.",
      "sources": [
        "src/lib/maxim-instant.ts:99"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Coming by bike, public transport or car? I'll gladly point you to the easiest route!",
