      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Send your request to contact@maximilien.brussels. If our answer does not satisfy you, you can lodge a complaint with the Belgian Data Protection Authority, Rue de la Presse 35, 1000 Brussels — dataprotectionauthority.be.",
