      "sources": [
        "src/lib/cookie-statement.ts:118"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "European rules only require consent for cookies that are not strictly necessary. We set none of those, so there is no banner and no consent screen.",
      "sources": [
