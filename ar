      "germanPhrasePresent": false
    },
    {
      "text": "Allowed, but in moderation.",
      "sources": [
        "src/lib/maxim-context.ts:257"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "I'm not sure — ask a compost steward on site.",
      "sources": [
        "src/lib/maxim-context.ts:258"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Meat, fish and bones attract pests.",
      "sources": [
        "src/lib/maxim-context.ts:260"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Dairy rots and causes bad smells.",
      "sources": [
        "src/lib/maxim-context.ts:261"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Cooked leftovers, oil and sauce disturb the process.",
      "sources": [
        "src/lib/maxim-context.ts:262"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Pet waste can carry pathogens.",
      "sources": [
        "src/lib/maxim-context.ts:263"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Non-compostable material belongs in residual waste.",
      "sources": [
        "src/lib/maxim-context.ts:264"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Citrus peel acidifies the heap — small amounts only.",
      "sources": [
        "src/lib/maxim-context.ts:265"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Bread and pasta attract rats — cut small and cover well.",
      "sources": [
        "src/lib/maxim-context.ts:266"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Fruit and vegetable scraps are ideal green material.",
      "sources": [
        "src/lib/maxim-context.ts:267"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Coffee grounds and tea are excellent nitrogen sources.",
      "sources": [
        "src/lib/maxim-context.ts:268"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Crush eggshells so they break down faster.",
      "sources": [
        "src/lib/maxim-context.ts:269"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Garden waste adds structure to the heap.",
      "sources": [
        "src/lib/maxim-context.ts:270"
      ],
      "germanPhrasePresent": false
    },
    {
      "text": "Unprinted cardboard is good brown material.",
      "sources": [
        "src/lib/maxim-context.ts:271"
      ],
